{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src/app/attractions/components/AttractionsSection.jsx",
    "src/app/components/GallerySection.jsx",
    "src/app/components/StickyNavbar.jsx",
    "src/app/components/TicketsSection.jsx",
    "src/app/offres/components/EntrepriseSection.jsx",
    "src/app/offres/components/ScolaireSection.jsx",
    "./.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
